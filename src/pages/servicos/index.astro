---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site } from '../../data/site';
import { servicos } from '../../data/servicos';
import { breadcrumbSchema } from '../../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
];
---

<Base
  title="Serviços de Desentupimento em BH 24h | Exata BH"
  description="Desentupimento de pia, ralo, vaso sanitário e esgoto, e limpa fossa em Belo Horizonte. Desentupidora Exata BH, atendimento 24 horas com garantia."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Serviços</span>
      <h1>Serviços de desentupimento em BH</h1>
      <p class="hero-lead">Desentupimento sem quebra-quebra, 24 horas, com chegada em até {site.arrivalMinutes} minutos e garantia.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
